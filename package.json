{
  "name": "ai-portal-library",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly AI-portal screenshot library — a Cloudflare Workers app that captures, stores, analyses and displays the landing pages of every major AI/LLM portal.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:init:local": "wrangler d1 execute ai-portal-library --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ai-portal-library --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute ai-portal-library --local --file=./migrations/0001_add_mobile.sql",
    "db:migrate:remote": "wrangler d1 execute ai-portal-library --remote --file=./migrations/0001_add_mobile.sql",
    "seed:gen": "node ./scripts/gen-seed.mjs",
    "seed:local": "wrangler d1 execute ai-portal-library --local --file=./seed.sql",
    "seed:remote": "wrangler d1 execute ai-portal-library --remote --file=./seed.sql",
    "db:migrate:manual:local": "wrangler d1 execute ai-portal-library --local --file=./migrations/0002_manual_shots.sql",
    "db:migrate:manual:remote": "wrangler d1 execute ai-portal-library --remote --file=./migrations/0002_manual_shots.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "@cloudflare/voice": "^0.3.5",
    "agents": "^0.20.1",
    "ai": "^7.0.66",
    "fflate": "^0.8.3",
    "workers-ai-provider": "^4.0.0"
  }
}
